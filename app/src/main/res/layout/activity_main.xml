<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SMK NEGERI 1 MARANCAR"
            android:textColor="@color/hijau"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Presensi Siswa"
            style="@style/JudulLayar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Guru membuat QR sesi, siswa memindai untuk mencatat kehadiran."
            style="@style/TeksKecil" />

        <Button
            android:id="@+id/btnGuru"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Saya Guru — buat QR sesi"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSiswa"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Saya Siswa — pindai QR"
            android:textSize="16sp"
            android:backgroundTint="@color/hijau_muda"
            android:textColor="@color/hijau_tua" />

        <TextView
            android:id="@+id/txtVersi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Versi 1.1"
            style="@style/TeksKecil" />
    </LinearLayout>
</ScrollView>
