<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buka Sesi Presensi"
            style="@style/JudulLayar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="Cukup tiga isian, lalu QR langsung tampil."
            style="@style/TeksKecil" />

        <EditText
            android:id="@+id/inputGuru"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_kartu"
            android:hint="Nama guru"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:autofillHints="name" />

        <EditText
            android:id="@+id/inputMapel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kartu"
            android:hint="Mata pelajaran"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:autofillHints="" />

        <AutoCompleteTextView
            android:id="@+id/inputKelas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kartu"
            android:hint="Kelas"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:completionThreshold="1" />

        <Button
            android:id="@+id/btnBuka"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="Buka Sesi &amp; Tampilkan QR"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            style="@style/TeksKecil" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRoster"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hijau_muda"
                android:text="Data Siswa"
                android:textColor="@color/hijau_tua"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRekap"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hijau_muda"
                android:text="Rekap"
                android:textColor="@color/hijau_tua"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
