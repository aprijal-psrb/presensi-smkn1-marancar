<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rekap Kehadiran"
        style="@style/JudulLayar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <AutoCompleteTextView
            android:id="@+id/inputKelas"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_kartu"
            android:hint="Kelas (semua)"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:completionThreshold="1" />

        <AutoCompleteTextView
            android:id="@+id/inputMapel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_kartu"
            android:hint="Mapel (semua)"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:completionThreshold="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTanggal"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:backgroundTint="@color/hijau_muda"
            android:text="Tanggal"
            android:textColor="@color/hijau_tua"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSemuaTanggal"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/hijau_muda"
            android:text="Semua tanggal"
            android:textColor="@color/hijau_tua"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTampil"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Tampilkan"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtRingkas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/hijau_tua"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listSesi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@color/abu_muda"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnEkspor"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Ekspor Rekap (CSV)"
        android:textSize="15sp" />
</LinearLayout>
